# ───────────────────────────────────────────────────────────
# Vercel 환경변수 예시 (실제 값은 Vercel 대시보드 > Settings > Environment Variables 에 입력)
# 로컬 개발 시에는 .env.local 로 복사해서 사용하세요. .env 는 커밋하지 마세요.
# ───────────────────────────────────────────────────────────

# 1) Upstash Redis (KV) — Vercel Marketplace 에서 Upstash 연동 시 자동 주입됩니다.
#    아래 둘 중 어떤 이름으로 들어오든 코드가 자동 인식합니다.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 또는
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# 2) 네이버 데이터랩 API (선택) — 없으면 네이버 데이터랩은 mock 데이터로 동작
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 2-1) 네이버 검색 API (블로그/카페) — 데이터랩과 다른 앱/키를 쓸 경우 여기에 입력.
#      비워두면 위 NAVER_CLIENT_ID/SECRET 를 그대로 사용(폴백). 없으면 블로그/카페는 mock.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# 2-2) YouTube Data API v3 키 (선택) — 없으면 YouTube는 mock 데이터로 동작
YOUTUBE_API_KEY=

# 3) 수집/리포트 엔드포인트 보호용 비밀키 (선택, 권장)
#    설정 시 외부에서 /api/collect 호출하려면 ?key=<값> 이 필요합니다.
#    Vercel Cron 은 이 값을 Authorization 헤더로 자동 전송합니다.
CRON_SECRET=
